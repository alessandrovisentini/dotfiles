{pkgs, ...}: {
  _module.args.settings = import ./settings.nix;

  imports = [
    /etc/nixos/hardware-configuration.nix # machine-specific, generated by nixos-generate-config
    ./specialisation.nix
    ./base.nix
    ./hardware.nix
    ./power.nix
    ./main_user.nix
    ./apps.nix
    ./audio.nix
    ./sway.nix
    ./printing.nix
    ./mime_apps.nix
    ./iphone.nix
    ./nix.nix
  ];

  boot = {
    kernelPackages = pkgs.linuxPackages_latest;

    loader.efi.canTouchEfiVariables = true;
    loader.systemd-boot.enable = true;
    loader.systemd-boot.configurationLimit = 5;

    initrd.systemd.enable = true;

    consoleLogLevel = 0;
    kernelParams = [
      "quiet"
      "boot.shell_on_fail"
      "rd.systemd.show_status=false"
      "rd.udev.log_level=3"
      "udev.log_priority=3"
    ];

    plymouth.enable = true; # LUKS password screen
  };

  system.stateVersion = "25.11";
}
